{
  "name": "vigilante-ball-thunder-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API + JobManager + MuScriptor Python worker for audio -> MIDI/MusicXML transcription.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "multer": "^2.4.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "vitest": "^2.1.9"
  }
}
