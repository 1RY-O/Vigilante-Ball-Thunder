# Copy to .env (never commit .env; it holds your Hugging Face token).

# REQUIRED for real transcription. Create at https://huggingface.co/settings/tokens
# and ACCEPT the license on the model page first:
#   https://huggingface.co/MuScriptor/muscriptor-small (or -medium / -large)
# The token is read by the Python worker; it is never logged or sent to clients.
HF_TOKEN=

# Engine: "muscriptor" (real model) or "stub" (MOCK — synthetic test fixtures
# only, clearly labeled in the API/UI; never use for real results).
TRANSCRIPTION_ENGINE=muscriptor

# Model variant: small (103M, CPU-friendly) | medium (307M) | large (1.4B, GPU)
MUSCRIPTOR_MODEL=small

# Python interpreter that has the worker deps installed (see python/requirements.txt).
# Defaults to backend/.venv/bin/python when it exists, else "python3".
# PYTHON_BIN=

# Server
PORT=4000
HOST=127.0.0.1
MAX_UPLOAD_BYTES=26214400
MAX_AUDIO_DURATION_SEC=600
JOB_TTL_SEC=1800
WORKER_TIMEOUT_MS=1800000

# Budget for one MuScriptor availability check (python deps + gated-weight
# access). A CPU-only cold start (torch import + ~400MB model metadata) takes
# 45-60s on an 8GB laptop, and the check runs in the background, so this is
# deliberately generous. Raise it if your machine is slower than that.
MUSCRIPTOR_SELFCHECK_TIMEOUT_MS=120000

# Rate limiting (per IP) for POST /api/transcriptions
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
